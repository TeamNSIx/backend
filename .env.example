APP_NAME=KFU Student Adaptation Chatbot
DEBUG=false
LOGGING__LEVEL=INFO
LOGGING__LOG_FILE=my_log.log
DB__SCHEMA=postgresql+asyncpg
# Для docker compose оставьте db; для локального uv — localhost
DB__HOST=db
DB__USER=postgres
DB__PASSWORD=postgres
DB__PORT=5432
DB__NAME=kfu_chatbot
AUTH__SECRET=change-this-secret-at-least-32-chars
AUTH__ALGORITHM=HS256
AUTH__ACCESS_TOKEN_LIFETIME_SECONDS=3600
AUTH__REFRESH_TOKEN_LIFETIME_SECONDS=3600
SMTP__HOST=smtp.example.com
SMTP__PORT=587
SMTP__USERNAME=your-smtp-username
SMTP__PASSWORD=your-smtp-password
SMTP__FROM_EMAIL=noreply@example.com
SMTP__FROM_NAME=KFU Chatbot
SMTP__STARTTLS=true
SMTP__SSL_TLS=false
SMTP__USE_CREDENTIALS=true
EMAIL__ENABLED=false
EMAIL__FRONTEND_BASE_URL=http://localhost
EMAIL__CONFIRMATION_PATH=/confirm
EMAIL__CONFIRMATION_TOKEN_LIFETIME_SECONDS=86400
CORS__ENABLED=true
CORS__ALLOW_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
CORS__ALLOW_CREDENTIALS=true
CORS__ALLOW_METHODS=GET,POST,PATCH,OPTIONS
CORS__ALLOW_HEADERS=Authorization,Content-Type,Accept
RATE_LIMIT__ENABLED=true
RATE_LIMIT__DEFAULT=60/minute
RATE_LIMIT__AUTH=10/minute
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_ACCESS_LOG=-
GUNICORN_ERROR_LOG=-
GUNICORN_LOG_LEVEL=info
RBAC__ADMIN_EMAIL=admin@example.com
RBAC__ADMIN_PASSWORD=admin-change-me
RBAC__ADMIN_ROLE_NAME=admin
RBAC__PUBLIC_ROLE_NAME=public
LLM__PROVIDER=gigachat
LLM__FALLBACK_ANSWER=Сообщение сохранено. LLM пока недоступна или не настроена.
GIGACHAT__AUTH_KEY=
GIGACHAT__SCOPE=GIGACHAT_API_PERS
GIGACHAT__MODEL=GigaChat-2
GIGACHAT__BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT__OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT__TIMEOUT_SECONDS=30
GIGACHAT__VERIFY_SSL=true
GIGACHAT__TEMPERATURE=0.2
GIGACHAT__MAX_TOKENS=700
